class Solution(object):
    def numRollsToTarget(self, n, k, target):
        MOD = 10**9 + 7

        if target < n or target > n * k:
            return 0

        dp = [0] * (target + 1)
        dp[0] = 1

        for dice in range(1, n + 1):
            curr = [0] * (target + 1)
            window = 0

            for total in range(1, target + 1):
                window += dp[total - 1]

                if total - k - 1 >= 0:
                    window -= dp[total - k - 1]

                curr[total] = window % MOD

            dp = curr

        return dp[target]
        
